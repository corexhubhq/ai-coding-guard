{
  "name": "corexhubhq/ai-coding-guard",
  "description": "Guardrail layer that makes AI coding agents state a hypothesis and a measurable prediction, then applies, tests, evaluates and learns from every change in a Laravel project.",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "ai", "guardrail", "llm", "claude", "code-review"],
  "require": {
    "php": "^8.2",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "symfony/process": "^7.0|^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "AICodingGuard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AICodingGuard\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "AICodingGuard\\AiCodingGuardServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
